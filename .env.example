DATABASE_URL="file:./dev.db"

# --- Plaid (sandbox by default) ---------------------------------------------
# Get these from https://dashboard.plaid.com/developers/keys
# PLAID_ENV: "sandbox" | "development" | "production"
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# Optional. If set, the app exposes a "Try sandbox link" button that uses this
# secret regardless of PLAID_ENV. Lets you test the Link UI against fake banks
# while your production account waits for OAuth institution registration.
PLAID_SANDBOX_SECRET=""
PLAID_ENV="sandbox"
# Comma-separated Plaid products. "transactions" is the only one required
# for MSR tracking. Add "auth" if you later want ACH on the liquidation side.
PLAID_PRODUCTS="transactions"
# Plaid requires at least one country code. US-only for now.
PLAID_COUNTRY_CODES="US"
# Required for OAuth institutions (Amex, Chase, Capital One, Wells Fargo, etc.)
# in production/development. Sandbox ignores this. The value MUST match a URI
# registered in Plaid Dashboard → API → Allowed redirect URIs, EXACTLY —
# scheme + host + path + trailing slash. Default falls back to localhost:3000/.
PLAID_REDIRECT_URI="http://localhost:3000/"
